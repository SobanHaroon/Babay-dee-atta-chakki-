# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# NTFY topic for real-time mobile push notifications when order is placed
NTFY_TOPIC=

# Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Geoapify API Keys for Interactive Map Tiles, Routing Road Distance, and Geocoding
GEOAPIFY_API_KEY=
GEOAPIFY_MAP_TILES_KEY=
GEOAPIFY_ROUTING_KEY=
GEOAPIFY_GEOCODING_KEY=
VITE_GEOAPIFY_API_KEY=

# SMSPK SMS Notification Configuration (Direct Pakistan SMS Gateway)
# Used to send instant confirmation text messages to Pakistani customer phone numbers (Jazz, Zong, Telenor, Ufone)
SMSPK_API_KEY=
SMSPK_SENDER_ID=

# Twilio SMS Notification Configuration
# Used to send instant confirmation text messages to customer phone numbers after checkout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

