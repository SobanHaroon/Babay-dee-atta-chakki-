# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# NTFY topic for real-time mobile push notifications when order is placed
NTFY_TOPIC=
NTFY_TOKEN=

# Server-only admin bearer token (at least 32 random characters). Never use a VITE_ prefix.
ADMIN_API_TOKEN=
# Comma-separated exact origins for preview/staging storefronts.
ALLOWED_ORIGINS=
# Set only to the known number of trusted reverse proxy hops for your deployment.
TRUST_PROXY_HOPS=

# Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Alternatively use the legacy server-only service-role key. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Mapbox token for server geocoding and driving routes. No token is embedded in source.
# VITE_MAPBOX_ACCESS_TOKEN is optional for the retained browser map component; use a public pk token only.
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# SMSPK SMS Notification Configuration (Direct Pakistan SMS Gateway)
# Used to send instant confirmation text messages to Pakistani customer phone numbers (Jazz, Zong, Telenor, Ufone)
SMSPK_API_KEY=
SMSPK_SENDER_ID=

# Twilio SMS Notification Configuration
# Used to send instant confirmation text messages to customer phone numbers after checkout
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Email Service Configuration (Resend or SMTP / Nodemailer)
# Used to send beautifully formatted order summary receipts and tax invoices to customer emails
RESEND_API_KEY=
EMAIL_FROM=Babay Dee Atta Chakki <orders@babaydeechakki.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# Server-only address lookup. Reuse the authorized Geoapify geocoding key here.
GEOAPIFY_API_KEY=
GEOAPIFY_GEOCODING_KEY=
# Optional separate routing key; otherwise uses GEOAPIFY_API_KEY or GEOAPIFY_GEOCODING_KEY.
GEOAPIFY_ROUTING_KEY=
# Optional dedicated signing key (32+ random characters); defaults to the private Geoapify key.
# Keep identical across deployment instances so delivery quotes remain valid for 30 minutes.
DELIVERY_QUOTE_SECRET=
