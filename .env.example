# Separate staging from production. No real customer notifications during tests.
APP_ENV=staging
APP_URL=
ENABLE_CUSTOMER_NOTIFICATIONS=false
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=

# Server only: never prefix private credentials with VITE_.
SUPABASE_URL=https://dlinknypnlmcrhgbediu.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
GEOAPIFY_API_KEY=
GEOAPIFY_GEOCODING_KEY=
GEOAPIFY_ROUTING_KEY=

# Three independent random secrets, at least 32 characters, stable across instances.
DELIVERY_QUOTE_SECRET=
ORDER_ACCESS_SECRET=
RATE_LIMIT_SECRET=

# Owner-verified store pin; no guessed coordinate fallback.
STORE_LATITUDE=33.567341
STORE_LONGITUDE=73.1044791
STORE_NAME=Babay Dee Atta Chakki
STORE_ADDRESS=
DELIVERY_RATE_PER_KM=50
DELIVERY_MIN_FEE=50
DELIVERY_MAX_DISTANCE_KM=30
DELIVERY_PRICING_VERSION=owner-confirmed-2026-10-11
# Approved administrative areas, verified server-side from the destination pin.
DELIVERY_SERVICE_AREAS=Rawalpindi,Islamabad
# Optional additional owner-approved south,west,north,east rectangle.
DELIVERY_SERVICE_BOUNDS=

# Intentionally public map tiles token: restrict APIs and approved site origins.
VITE_MAPBOX_ACCESS_TOKEN=
# Only owner-approved policy URLs are shown.
VITE_APPROVED_PRIVACY_URL=
VITE_APPROVED_DELIVERY_URL=
VITE_APPROVED_RETURNS_URL=

# Production notification credentials; leave unavailable in Preview/staging.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMSPK_API_KEY=
SMSPK_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Staging database only; never use the live project here. Used by db:staging.
STAGING_DATABASE_URL=

# Store-only ntfy alerts (separate from customer SMS/email). Preview/test are disabled.
ENABLE_STAFF_NOTIFICATIONS=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# Customer details are included: reserve the topic with private read permissions.
NTFY_ACCESS_TOKEN=
# Random server-only secret >=32 characters for the scheduled retry endpoint.
CRON_SECRET=
